#!/bin/sh /etc/rc.common
# signal-monitor: live LTE signal monitor for the two 4G routers (/usr/share/signalmon/signalmon.py).
# Runs only while signalmon.main.enabled=1 (LuCI: Services > Signal Monitor, or `ubus call signalmon start|stop`).
# auto_off minutes > 0: /var/run/signalmon/off_at holds the stop time; the server turns itself off when it passes.
START=99
USE_PROCD=1
RUN=/var/run/signalmon

start_service() {
	config_load signalmon
	config_get_bool enabled main enabled 0
	if [ "$enabled" != 1 ]; then
		rm -f $RUN/started $RUN/off_at
		return 0
	fi
	config_get auto_off main auto_off 60
	mkdir -p $RUN
	now=$(date +%s)
	echo "$now" > $RUN/started
	case "$auto_off" in
		''|*[!0-9]*|0) rm -f $RUN/off_at ;;
		*) echo $((now + auto_off * 60)) > $RUN/off_at ;;
	esac

	procd_open_instance
	procd_set_param command /usr/bin/python3 -u /usr/share/signalmon/signalmon.py
	# restart it when the settings change (LuCI Save & Apply)
	procd_set_param file /etc/config/signalmon
	procd_set_param respawn 3600 10 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f $RUN/started $RUN/off_at
}

service_triggers() {
	procd_add_reload_trigger signalmon
}
